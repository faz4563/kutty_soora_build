# Database Configuration
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Razorpay Configuration
# Get your keys from https://dashboard.razorpay.com/app/keys
# NOTE: Use test keys for development and live keys for production
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Security Configuration
# IMPORTANT: Change this to a strong, unique secret key in production!
# Generate using: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_HOUR=1000

# CORS Configuration
PRODUCTION_DOMAIN=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,http://yourdomain.com

# Session Settings
SESSION_LIFETIME=86400
TOKEN_EXPIRY=86400

# Admin Tokens (CHANGE THESE IN PRODUCTION!)
SETUP_TOKEN=your_unique_setup_token_here
MONITOR_TOKEN=your_unique_monitor_token_here
