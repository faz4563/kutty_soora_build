# CORS headers are handled in individual PHP files to avoid conflicts
# Uncomment the section below if you want to handle CORS globally instead
# <IfModule mod_headers.c>
#     Header always set Access-Control-Allow-Origin "*"
#     Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
#     Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept"
#     Header always set Access-Control-Max-Age "86400"
#     Header always set Access-Control-Allow-Credentials "true"
#     Header always set Access-Control-Expose-Headers "Content-Length, Content-Range"
# </IfModule>

# Let PHP files handle their own OPTIONS requests and CORS
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # AGGRESSIVE Authorization header passing - try multiple methods
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
    
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=REDIRECT_HTTP_AUTHORIZATION:%1]
    
    # Set environment variable for CGI
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    
    # Don't interfere with OPTIONS - let PHP handle it
    # RewriteCond %{REQUEST_METHOD} ^OPTIONS
    # RewriteRule ^(.*)$ $1 [R=200,L]
    
    # Ensure PHP files are processed normally
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Enable CGI/FastCGI Authorization header
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# CORS headers are handled individually in PHP files
# Image files don't need CORS since they're served directly by Apache
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    # Images served directly without CORS conflicts
</FilesMatch>

# Cache control for images (optional - improves performance)
<IfModule mod_expires.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        ExpiresActive On
        ExpiresDefault "access plus 1 month"
    </FilesMatch>
</IfModule>

# Enhanced Security headers
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Prevent clickjacking attacks
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (adjust as needed)
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
    
    # Remove server information
    Header always unset X-Powered-By
    Header always unset Server
    
    # Permissions Policy (restrict features)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Hide PHP version
ServerSignature Off

# Protect sensitive files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(log|ini|conf|sql|bak|backup)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect against directory browsing
Options -Indexes

# Protect against SQL injection in URLs
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} (\.|%2E)(\.|%2E)(/|%2F) [OR]
    RewriteCond %{QUERY_STRING} (union.*select|select.*union) [NC,OR]
    RewriteCond %{QUERY_STRING} (drop|insert|cast|create|char) [NC]
    RewriteRule .* - [F,L]
</IfModule>